{
  "name": "personal_frontend",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@date-io/date-fns": "^2.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^5.16.14",
    "@mui/lab": "^5.0.0-alpha.60",
    "@mui/material": "^5.16.7",
    "@mui/utils": "^5.11.0",
    "@mui/x-date-pickers": "^7.18.0",
    "@popperjs/core": "^2.11.8",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "axios": "^1.7.9",
    "date-fns": "^2.28.0",
    "framer-motion": "^12.4.2",
    "http-proxy-middleware": "^3.0.3",
    "lodash": "^4.17.21",
    "minimatch": "^3.0.5",
    "node-forge": "^1.3.0",
    "nth-check": "^2.0.1",
    "postcss": "^8.4.31",
    "react": "^18.3.1",
    "react-beautiful-dnd": "^13.1.1",
    "react-confetti": "^6.2.2",
    "react-dom": "^18.3.1",
    "react-dropzone": "^14.3.8",
    "react-infinite-scroll-component": "^6.1.0",
    "react-is": "^19.0.0",
    "react-quill": "^2.0.0",
    "react-router-dom": "^6.26.2",
    "react-scripts": "^5.0.1",
    "react-transition-group": "^4.4.5",
    "semver": "^7.5.2",
    "serialize-javascript": "^6.0.2",
    "shell-quote": "^1.7.3",
    "terser": "^5.16.1",
    "tough-cookie": "^4.1.3",
    "use-sound": "^4.0.3",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "test:coverage": "react-scripts test --coverage --watchAll=false",
    "test:ui": "react-scripts test --testPathPattern=src/ui --watchAll=false",
    "test:ui:coverage": "react-scripts test --coverage --testPathPattern=src/ui --watchAll=false",
    "test:ui:organisms": "react-scripts test --testPathPattern=src/ui/organisms --watchAll=false",
    "test:ui:organisms:coverage": "react-scripts test --coverage --testPathPattern=src/ui/organisms --watchAll=false",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "jest": {
    "collectCoverageFrom": [
      "src/ui/**/*.{js,jsx}",
      "!src/ui/**/*.stories.js",
      "!src/ui/**/index.js",
      "!src/ui/examples/**",
      "!src/ui/docs/**"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 80,
        "branches": 80,
        "functions": 80,
        "lines": 80
      }
    },
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ],
    "moduleNameMapper": {
      "\\.(css|less|scss|sass)$": "<rootDir>/src/__mocks__/styleMock.js",
      "^../../utilities/responsive-props$": "<rootDir>/src/__mocks__/useResponsiveProps.js",
      "^../../utilities/component-extension$": "<rootDir>/src/__mocks__/componentExtension.js",
      "^../../atoms$": "<rootDir>/src/__mocks__/ui-components.js",
      "^../../molecules$": "<rootDir>/src/__mocks__/ui-components.js"
    }
  },
  "devDependencies": {
    "@babel/core": "^7.26.9",
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@babel/plugin-syntax-dynamic-import": "^7.8.3",
    "@babel/plugin-transform-react-jsx-development": "^7.25.9",
    "@babel/preset-env": "^7.26.9",
    "@babel/preset-react": "^7.26.3",
    "babel-loader": "^9.2.1",
    "css-loader": "^7.1.2",
    "html-webpack-plugin": "^5.6.3",
    "postcss-loader": "^8.1.1",
    "source-map-loader": "^5.0.0",
    "style-loader": "^4.0.0",
    "webpack": "^5.98.0",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.0"
  },
  "overrides": {
    "lodash": "^4.17.21",
    "nth-check": "^2.0.1",
    "postcss": "^8.4.31",
    "serialize-javascript": "^6.0.2",
    "tough-cookie": "^4.1.3",
    "minimatch": "^3.0.5",
    "node-forge": "^1.3.0",
    "shell-quote": "^1.7.3",
    "terser": "^5.16.1",
    "semver": "^7.5.2",
    "webpack-dev-middleware": "^5.3.4",
    "yargs-parser": "^21.1.1",
    "quill": "^2.0.0-dev.4",
    "quilljs": {
      "lodash": "^4.17.21"
    },
    "css-select": {
      "nth-check": "^2.0.1"
    },
    "svgo": {
      "css-select": {
        "nth-check": "^2.0.1"
      }
    }
  }
}
